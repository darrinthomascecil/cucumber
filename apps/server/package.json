{
  "name": "@cucumber/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=../../.env --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:fastify --external:@fastify/* --external:@prisma/client --external:.prisma/* --external:ws --external:zod",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@cucumber/database": "workspace:*",
    "@cucumber/game-engine": "workspace:*",
    "@cucumber/shared": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.0.4",
    "@fastify/websocket": "11.0.1",
    "@prisma/client": "6.2.1",
    "fastify": "5.2.1",
    "prisma": "6.2.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "@types/ws": "8.5.13"
  }
}
