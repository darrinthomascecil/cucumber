{
  "name": "cucumber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cucumber/server --filter @cucumber/web dev",
    "dev:server": "pnpm --filter @cucumber/server dev",
    "dev:web": "pnpm --filter @cucumber/web dev",
    "build": "pnpm --filter @cucumber/web build && pnpm --filter @cucumber/server build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @cucumber/database generate",
    "db:push": "pnpm --filter @cucumber/database push",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "local:players": "node --experimental-strip-types --env-file-if-exists=.env tools/local-players.ts",
    "self-play": "node --experimental-strip-types tools/self-play.ts",
    "record": "node --experimental-strip-types --env-file-if-exists=.env tools/record-game.ts"
  },
  "devDependencies": {
    "@cucumber/database": "workspace:*",
    "@cucumber/game-engine": "workspace:*",
    "@cucumber/shared": "workspace:*",
    "@cucumber/strategy": "workspace:*",
    "@types/node": "22.20.2",
    "@types/ws": "8.5.13",
    "playwright": "^1.63.0",
    "typescript": "5.7.3",
    "vitest": "3.2.7",
    "ws": "8.18.0"
  }
}
