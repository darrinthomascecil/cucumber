# Postgres (docker compose up -d postgres provides this by default)
DATABASE_URL="postgresql://cucumber:cucumber@localhost:5432/cucumber?schema=public"

# 32+ char secret used to sign session cookies
SESSION_SECRET="change-me-to-a-long-random-string-please"

# The first administrator. On boot the server ensures this user exists as an
# ACTIVE admin and prints a one-time invite link for them.
ADMIN_EMAIL="you@example.com"
ADMIN_DISPLAY_NAME="Admin"

PORT=8080
WEB_ORIGIN="http://localhost:5173"

# Seat ADMIN_EMAIL on arrival instead of asking for an invitation. Development
# only — the server refuses to start with this set and NODE_ENV=production.
DEV_AUTO_SIGN_IN=0
